# Baseline for every static response. HSTS was one day while the site lived on a
# temporary demo host. The final domain is now live and HTTPS-only, so it is
# raised to 180 days. No includeSubDomains: that would also lock any future
# subdomain into HTTPS before one exists, and it cannot be undone quickly.
#
# ⚠️  DO NOT put a Content-Security-Policy on /* here. When two rules match the
#     same path, Cloudflare JOINS the values with a comma, and a browser given
#     two policies enforces the INTERSECTION of both. A site-wide policy would
#     silently strip /admin/ of the sources the CMS needs. That is why every
#     policy below is written out per path instead.
/*
  Strict-Transport-Security: max-age=15552000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: DENY

# The public site is fully self-hosted. There is no third party left: online
# booking runs on the site's own picker against /api/*, and the customer is sent
# to MobilePay by a plain top-level navigation, which no CSP directive governs.
#
# form-action stays 'self'. Do NOT send the customer to MobilePay by posting a
# form to the Worker and redirecting: Chrome checks redirects against
# form-action too, and it would be blocked. static/js/booking.js uses fetch and
# then location.href for exactly this reason.
/
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; form-action 'self'; upgrade-insecure-requests

/en/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; form-action 'self'; upgrade-insecure-requests

# The Danish sub-pages are not covered by / or /en/*, so they get the policy
# spelled out. Add a rule here for every new Danish page.
/politik/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; form-action 'self'; upgrade-insecure-requests

/privatliv/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; form-action 'self'; upgrade-insecure-requests

# The booking receipt shows a customer's name, appointment and the full street
# address. It must never be indexed and must never be held in a shared cache.
# The page itself is empty without a valid reference, but the rule belongs here
# rather than resting on that.
/tak/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; form-action 'self'; upgrade-insecure-requests
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/en/thanks/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/404.html
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; form-action 'self'; upgrade-insecure-requests

# Sveltia is self-hosted. Its exact-version image processors and the pinned,
# integrity-checked YAML parser for Review all text are loaded from UNPKG.
# GitHub and the client-owned OAuth Worker are the only APIs.
/admin/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' https://unpkg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https://cdn.jsdelivr.net; connect-src 'self' https://api.github.com https://github.com https://unpkg.com https://cdn.jsdelivr.net https://*.workers.dev; frame-src 'self' blob:; worker-src 'self' blob:; manifest-src 'self'; form-action 'self' https://github.com https://*.workers.dev; upgrade-insecure-requests

# The temporary client-review hostname must never compete with the final domain.
https://wiktoria.christiansdemo.dk/*
  X-Robots-Tag: noindex

# Cloudflare serves the whole site on the Worker's own workers.dev hostname as
# well. It answers 200 and is a second public copy of the site. The canonical
# tag points home, but a canonical is a hint and not a rule, so the header says
# it outright. Stronger still is "workers_dev": false in wrangler.jsonc, which
# removes the address entirely; it is left on for now because preview URLs are
# not enabled on the account and this is the only non-production way in.
https://w-website.wiktoriagordon.workers.dev/*
  X-Robots-Tag: noindex, nofollow
