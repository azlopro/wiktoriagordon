{{- /* Behandlingernes pris i øre, slået op på Cal-slug'en.

     Workeren regner depositummet ud herfra. Beløbet må ALDRIG komme fra
     browseren: query-parametre kan redigeres i adresselinjen, og så kunne
     enhver booke det store sæt og betale én krone.

     Priserne står som fri tekst i prislisten ("500 kr."), fordi det er sådan
     kunden skal se dem. Her trækkes tallet ud, så bookingen ikke kan komme
     til at regne på en tekststreng. */ -}}
{{- $L := .Site.Language.Lang -}}
{{- $s := index hugo.Data.services $L -}}
{{- /* Fast depositum på tværs af alle behandlinger, Wiktorias eget valg
     (26/8-2026). Var 50 % af prisen. Bemærk at det for den billigste
     behandling betyder fuld forudbetaling, og at depositummet ikke
     refunderes. */ -}}
{{- $deposit := 200 -}}
{{- $out := dict -}}
{{- range $svc := $s.main -}}
  {{- with $svc.calSlug -}}
    {{- $kr := int (replaceRE `[^0-9]` "" $svc.price) -}}
    {{- /* Aldrig mere end prisen: et depositum større end behandlingen ville
         være en fejl, uanset hvad tallet ovenfor bliver sat til. */ -}}
    {{- $dep := cond (lt $kr $deposit) $kr $deposit -}}
    {{- $out = merge $out (dict . (dict
        "title" $svc.title
        "priceOere" (int (mul $kr 100))
        "depositOere" (int (mul $dep 100)))) -}}
  {{- end -}}
{{- end -}}
{{ dict "currency" "DKK" "depositOere" (int (mul $deposit 100)) "treatments" $out | jsonify (dict "indent" "  ") }}
